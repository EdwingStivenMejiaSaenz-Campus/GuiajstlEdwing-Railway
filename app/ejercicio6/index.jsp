<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ejercicio 6</title><link rel="stylesheet" href="../css/estilo.css"></head><body><div class="topbar"><div class="topbar-inner"><div class="logo">JSTL</div><a class="home-link" href="../index.jsp">Inicio</a></div></div><section class="exercise-hero ex6"><div class="hero-copy"><h1>EJERCICIO 6</h1><p>c:forEach</p></div></section><main class="main"><div class="library-strip ex6">LIBRERÍA CORE</div><div class="content-card"><h3 style="text-align:left">Uso de c:forEach</h3><div class="numbers"><c:forEach begin="1" end="24" step="2" var="hour" varStatus="status"><p><c:out value="${hour}"/> <c:if test="${status.first}"><strong>Estoy en uno</strong></c:if><c:if test="${status.count == 5}"><strong>Estoy en la iteración numero 5</strong></c:if></p></c:forEach></div></div></main><footer class="footer">GuiajstlEdwing</footer></body></html>
