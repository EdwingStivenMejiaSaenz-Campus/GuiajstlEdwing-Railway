<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<c:if test="${not empty param.parametro or not empty param.vacio}"><c:catch var="error01"><c:choose><c:when test="${empty param.parametro}"><c:set var="valor" value="${'NO_NUMERO' + 0}"/></c:when><c:otherwise><c:set var="valor" value="${param.parametro + 0}"/></c:otherwise></c:choose></c:catch></c:if>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ejercicio 5</title><link rel="stylesheet" href="../css/estilo.css"></head><body><div class="topbar"><div class="topbar-inner"><div class="logo">JSTL</div><a class="home-link" href="../index.jsp">Inicio</a></div></div><section class="exercise-hero ex5"><div class="hero-copy"><h1>EJERCICIO 5</h1><p>Captura de excepciones con c:catch</p></div></section><main class="main"><div class="library-strip ex5">LIBRERÍA CORE</div><div class="content-card narrow"><c:if test="${not empty param.parametro || not empty error01}"><c:if test="${not empty error01}"><div class="alert"><strong>Se produjo un error</strong></div></c:if><c:if test="${empty error01}"><div class="alert info"><strong>Valor recibido: <c:out value="${valor}"/></strong></div></c:if></c:if><div class="actions"><form><input type="hidden" name="parametro" value="prueba"><button class="btn dark" type="submit">Enviar 'prueba'</button></form><form><input type="hidden" name="parametro" value="1234"><button class="btn green" type="submit">Enviar '1234'</button></form><form><input type="hidden" name="vacio" value="1"><button class="btn red" type="submit">No enviar el parámetro</button></form></div></div></main><footer class="footer">GuiajstlEdwing</footer></body></html>
